{
  "name": "triple-zero",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "ci:run": "payload migrate && pnpm build",
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create --skip-empty",
    "lint": "next lint",
    "check-types": "tsc --pretty --noEmit",
    "payload": "payload",
    "start": "next start",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation\" npm exec playwright test",
    "test:int": "vitest run --config ./vitest.config.mts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@innovixx/payload-color-picker-field": "^2.0.2",
    "@payloadcms/db-mongodb": "3.57.0",
    "@payloadcms/db-postgres": "3.57.0",
    "@payloadcms/next": "3.57.0",
    "@payloadcms/payload-cloud": "3.57.0",
    "@payloadcms/richtext-lexical": "3.57.0",
    "@payloadcms/storage-s3": "3.57.0",
    "@payloadcms/translations": "3.57.0",
    "@payloadcms/ui": "3.57.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^7.9.0",
    "@svgr/webpack": "^8.1.0",
    "@t3-oss/env-core": "^0.13.8",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tailwindcss/postcss": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.5",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.525.0",
    "next": "^15.5.7",
    "next-intl": "^4.5.8",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "node-mailjet": "^6.0.11",
    "nuqs": "^2.8.3",
    "payload": "3.57.0",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-fast-marquee": "^1.6.5",
    "react-hook-form": "^7.68.0",
    "schema-dts": "^1.1.5",
    "server-only": "^0.0.1",
    "sharp": "0.32.6",
    "short-unique-id": "^5.3.2",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "vaul": "^1.1.2",
    "zod": "^4.1.13",
    "zsa": "^0.6.0",
    "zsa-react": "^0.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "1.50.0",
    "@testing-library/react": "16.3.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.3.0",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "playwright": "1.50.0",
    "playwright-core": "1.50.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.65.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.14.0"
}
